# ============================================================
# Local AI Document Chat - Example Environment Configuration
# ============================================================
#
# Copy this file to `.env` for local development.
#
# Notes:
# - `.env` is intentionally excluded from Git.
# - Values here are safe example defaults.
# - Docker Compose may override some values at runtime.
# ============================================================


# ------------------------------------------------------------
# Local model inference
# ------------------------------------------------------------

# Base URL of the local OpenAI-compatible model endpoint.
#
# For local development, where FastAPI runs directly on Windows:
#   http://localhost:12434/engines/v1
#
# For the later Docker Compose setup, where the API container
# needs to reach Docker Model Runner on the host:
#   http://host.docker.internal:12434/engines/v1
#
# The application does not hard-code the inference provider.
LLM_URL=http://host.docker.internal:12434/engines/v1


# Identifier of the local language model used for generation.
#
# Final assessment model:
# - Qwen2.5 0.5B Instruct
# - GGUF format
# - Q4_K_M quantisation
# - approximately 630M parameters
# - runs fully locally through Docker Model Runner
#
# Changing this value allows another compatible local model to
# be used without changing application code.
LLM_MODEL=huggingface.co/qwen/qwen2.5-0.5b-instruct-gguf:Q4_K_M


# Maximum number of seconds allowed for a local model request.
#
# If the model does not respond within this period, the
# inference layer returns a controlled timeout error.
LLM_TIMEOUT_SECONDS=60


# ------------------------------------------------------------
# Corpus / document storage
# ------------------------------------------------------------

# Directory containing the live document corpus.
#
# The service currently supports UTF-8:
# - .txt
# - .md
#
# In Docker, the host ./data directory will be mounted at /data.
#
# Local development normally uses:
#   DATA_DIR=./data
#
# Container runtime uses:
#   DATA_DIR=/data
DATA_DIR=/data


# ------------------------------------------------------------
# General application settings
# ------------------------------------------------------------

# Application logging verbosity.
#
# Typical values:
# - DEBUG
# - INFO
# - WARNING
# - ERROR
#
# INFO is the normal operational setting.
LOG_LEVEL=INFO


# ------------------------------------------------------------
# Live corpus refresh
# ------------------------------------------------------------

# How often, in seconds, the application checks the corpus
# directory for file additions, modifications, renames or removals.
#
# Lower values detect changes more quickly but cause more frequent
# filesystem scans.
CORPUS_POLL_INTERVAL_SECONDS=1.0


# How long, in seconds, a detected filesystem change must remain
# unchanged before it is promoted into the active corpus.
#
# This reduces the risk of loading a document while another process
# is still writing it.
CORPUS_STABILITY_DELAY_SECONDS=0.5


# ------------------------------------------------------------
# Document chunking
# ------------------------------------------------------------

# Maximum size of each document chunk in characters.
#
# Larger chunks preserve more surrounding context but consume more
# of the model's context window.
CHUNK_SIZE_CHARS=1600


# Number of characters repeated between neighbouring chunks.
#
# Overlap helps preserve information that falls close to a chunk
# boundary.
#
# This value must always be smaller than CHUNK_SIZE_CHARS.
CHUNK_OVERLAP_CHARS=200


# ------------------------------------------------------------
# Evidence retrieval
# ------------------------------------------------------------

# Maximum number of top-ranked document chunks considered after
# lexical relevance scoring.
#
# This limits the candidate evidence set before context budgeting.
RETRIEVAL_TOP_K=8


# Minimum lexical relevance score required for a chunk to remain
# eligible as evidence.
#
# Chunks below this threshold are ignored rather than being passed
# to the model as weak or unrelated evidence.
RETRIEVAL_MIN_SCORE=0.10


# Maximum estimated token allowance for retrieved document evidence.
#
# This prevents the application from silently placing an excessive
# amount of document content into the model context.
#
# Current token counts are estimated rather than model-tokenizer
# exact, and are labelled as estimates in diagnostics.
CONTEXT_TOKEN_BUDGET=1800


# ------------------------------------------------------------
# Streamlit user interface
# ------------------------------------------------------------

# Base URL used by the Streamlit UI to call the FastAPI backend.
#
# For local development:
#   http://127.0.0.1:8000
#
# In Docker Compose, the UI container will use the API service name:
#   http://api:8000
BACKEND_URL=http://api:8000


# Maximum number of seconds the Streamlit UI waits for a backend
# chat request to complete.
#
# This is slightly longer than the model timeout so the backend has
# time to return a structured model timeout or failure event first.
UI_REQUEST_TIMEOUT_SECONDS=90