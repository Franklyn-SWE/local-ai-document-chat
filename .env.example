# ============================================================
# Local AI Document Chat - Example Environment Configuration
# ============================================================
#
# Copy this file to `.env` for local development.
#
# Notes:
# - `.env` is intentionally excluded from Git.
# - Values here are safe example defaults.
# - This configuration is for running FastAPI and Streamlit
#   directly on Windows.
# - Docker Compose requires different hostnames and paths,
#   as explained below.
# ============================================================


# ------------------------------------------------------------
# Local model inference - Ollama
# ------------------------------------------------------------

# Install Ollama:
# https://ollama.com/download/windows
#
# Download the model:
#   ollama pull qwen2.5:0.5b
#
# Test local inference:
#   ollama run qwen2.5:0.5b "Say hello."
#
# Ollama exposes an OpenAI-compatible API.
#
# Windows-local development:
#   http://localhost:11434/v1
#
# Docker Compose:
#   http://host.docker.internal:11434/v1
#
# For containerised access, Ollama must be reachable from
# Docker containers. This may require configuring Ollama's
# listening address and Docker networking.
#
# The application uses a configurable inference endpoint,
# so the inference provider is not hardcoded.

LLM_URL=http://localhost:11434/v1


# Local language model used for response generation.
#
# Model: Qwen 2.5 0.5B Instruct
# Provider: Ollama
# Parameters: approximately 0.5 billion
# Execution: fully local
#
# The model can be changed without modifying the RAG
# retrieval or inference client implementation.

LLM_MODEL=qwen2.5:0.5b


# Maximum duration, in seconds, for a model request.
#
# If inference exceeds this limit, the application returns
# a controlled timeout error.

LLM_TIMEOUT_SECONDS=60


# ------------------------------------------------------------
# Corpus / document storage
# ------------------------------------------------------------

# Directory containing the live document corpus.
#
# Supported document formats:
# - .txt
# - .md
#
# Windows-local development:
#   DATA_DIR=./data
#
# Docker Compose:
#   DATA_DIR=/data
#
# In Docker Compose, the host ./data directory should be
# mounted into the API container at /data.
#
# Documents can be added, modified, renamed or deleted.
# The application monitors changes and refreshes its
# searchable document corpus.

DATA_DIR=./data


# ------------------------------------------------------------
# General application settings
# ------------------------------------------------------------

# Application logging verbosity.
#
# Supported values:
# - DEBUG
# - INFO
# - WARNING
# - ERROR
#
# INFO is recommended for normal operation.

LOG_LEVEL=INFO


# ------------------------------------------------------------
# Live corpus refresh
# ------------------------------------------------------------

# How frequently, in seconds, the application checks for
# document additions, modifications, renames and deletions.
#
# Lower values provide faster detection but increase
# filesystem scanning frequency.

CORPUS_POLL_INTERVAL_SECONDS=1.0


# Stability delay, in seconds, before a detected document
# change is promoted into the active searchable corpus.
#
# This helps avoid processing partially written files.

CORPUS_STABILITY_DELAY_SECONDS=0.5


# ------------------------------------------------------------
# Document chunking
# ------------------------------------------------------------

# Maximum document chunk size in characters.
#
# Larger chunks preserve more surrounding context but
# consume more of the language model's context window.

CHUNK_SIZE_CHARS=1600


# Number of overlapping characters between adjacent chunks.
#
# Overlap preserves information near chunk boundaries.
#
# This value must be smaller than CHUNK_SIZE_CHARS.

CHUNK_OVERLAP_CHARS=200


# ------------------------------------------------------------
# Evidence retrieval
# ------------------------------------------------------------

# Maximum number of relevant document chunks considered
# during lexical retrieval.
#
# The application uses BM25-based retrieval to identify
# relevant evidence from the local document corpus.

RETRIEVAL_TOP_K=8


# Minimum lexical relevance score for evidence selection.
#
# Chunks below this threshold are excluded.
#
# This helps prevent weak or unrelated evidence from
# being supplied to the language model.

RETRIEVAL_MIN_SCORE=0.10


# Maximum estimated token budget for retrieved evidence.
#
# The application limits evidence supplied to the model
# to reduce context overflow and unnecessary processing.
#
# Token counts are estimates rather than exact
# model-tokenizer measurements.

CONTEXT_TOKEN_BUDGET=1800


# ------------------------------------------------------------
# Streamlit user interface
# ------------------------------------------------------------

# Base URL used by Streamlit to communicate with FastAPI.
#
# Windows-local development:
#   http://127.0.0.1:8000
#
# Docker Compose:
#   http://api:8000
#
# Use the Docker Compose service hostname when the
# Streamlit frontend runs inside a container.

BACKEND_URL=http://127.0.0.1:8000


# Maximum duration, in seconds, for a Streamlit request
# to the FastAPI backend.
#
# This is longer than LLM_TIMEOUT_SECONDS so the backend
# has time to return a controlled inference error.

UI_REQUEST_TIMEOUT_SECONDS=90


# ============================================================
# End of configuration
# ============================================================