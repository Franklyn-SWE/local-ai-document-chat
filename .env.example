# Local model endpoint
LLM_URL=http://host.docker.internal:12434/engines/v1

# Local model identifier
LLM_MODEL=ai/smollm2:360M-Q4_K_M

# Corpus
DATA_DIR=/data

# Application
LOG_LEVEL=INFO

CORPUS_POLL_INTERVAL_SECONDS=1.0
CORPUS_STABILITY_DELAY_SECONDS=0.5

CHUNK_SIZE_CHARS=1600
CHUNK_OVERLAP_CHARS=200

RETRIEVAL_TOP_K=8
CONTEXT_TOKEN_BUDGET=1800
RETRIEVAL_MIN_SCORE=0.10
